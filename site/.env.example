# Copy to .env (next to compose.yaml) and adjust. All settings are optional.

# Address and port on this machine. 127.0.0.1 keeps the site private to this
# machine; use 0.0.0.0 to let other computers on your network reach it.
PLUGIN_SITE_HOST_ADDRESS=127.0.0.1
PLUGIN_SITE_HOST_PORT=8731

# Port nginx listens on inside the container (rarely needs changing).
PLUGIN_SITE_CONTAINER_PORT=8080

# Public Trello Power-Up API key (32 hex characters; never a user token).
# Without it the Trello pages are served, but Trello authorization fails.
# Changing it requires a rebuild: docker compose up -d --build
TRELLO_APP_KEY=00000000000000000000000000000000
